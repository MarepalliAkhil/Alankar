# Local test of the production stack on your PC (docs/DEPLOY.md, "Local test"): plain HTTP on
# http://localhost:8088 with the local PostgreSQL container. Copy to .env.production.local and
# fill the three generated values. Never commit the filled file. NOT for a real server.

DOMAIN=localhost
SITE_URL=http://localhost:8088
IMAGE_TAG=local
ENV_FILE=.env.production.local

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SALON_SECRET_KEY=
SALON_JWT_SIGNING_KEY=
# Generate: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SALON_FIELD_KEY=

# The local database container (profile localdb). Pick any password; use the same in both lines.
LOCALDB_PASSWORD=
DATABASE_URL=postgresql://alankar:PUT_THE_SAME_PASSWORD_HERE@db:5432/alankar?sslmode=disable
REDIS_URL=redis://redis:6379/0

# Plain HTTP locally: no HTTPS redirect, no HSTS. (deploy_check reports these as errors; that is
# expected for the local test only.)
SALON_SSL_REDIRECT=false
SALON_HSTS_SECONDS=0
SALON_ALLOWED_HOSTS=localhost
SALON_CORS_ORIGINS=http://localhost:8088
SALON_FRONTEND_URL=http://localhost:8088

ADMIN_EMAIL=
ADMIN_NAME=Local Admin
ADMIN_PASSWORD=

# Empty = emails are simulated (saved in the outbox; customers' sign-in codes cannot be delivered,
# so the local test turns the customer email code off).
EMAIL_HOST=
SALON_CUSTOMER_OTP=false
