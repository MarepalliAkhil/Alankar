# Production settings for docker-compose.prod.yml (docs/DEPLOY.md). Copy to .env.production on the
# server, fill every empty value, and NEVER commit the filled file. Secret values are empty here
# on purpose; the command to generate each one is in the comment above it. Run the generators on
# your own PC (python 3) and paste the output.

# ---- Address and images -------------------------------------------------------------------------
# The host name only (no https://): the Azure public-IP DNS name now, a custom domain later.
DOMAIN=
# The site's address with https://, same host as DOMAIN. Also a GitHub repository variable for the
# image build (the prerendered pages and the sitemap contain it).
SITE_URL=
# Image tag to run: a commit SHA (or "latest"). deploy.sh and rollback.sh change it.
IMAGE_TAG=latest
# Email Let's Encrypt writes to about the certificate (optional but recommended).
ACME_EMAIL=
# Which env file the containers read (keep this value on the server).
ENV_FILE=.env.production

# ---- Django -------------------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SALON_SECRET_KEY=
# Signing key for the sign-in tokens (JWT). Empty = use SALON_SECRET_KEY.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SALON_JWT_SIGNING_KEY=
# Field-encryption master key: 32 random bytes, base64. The encryption key and the blind-index key
# (phone search) are both derived from it with HKDF, so this ONE key protects phones, allergies,
# notes and chat. BACK IT UP OFFLINE: losing it makes that data unreadable forever.
# Generate: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SALON_FIELD_KEY=

# ---- Database (Azure Database for PostgreSQL Flexible Server) ------------------------------------
# postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/alankar?sslmode=require
# Percent-encode special characters in the password: python -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "your password"
# Generate a strong password: python -c "import secrets; print(secrets.token_urlsafe(24))"
DATABASE_URL=
# Redis inside the stack (leave as is).
REDIS_URL=redis://redis:6379/0

# ---- First launch (scripts/deploy/first_run.sh) -------------------------------------------------
# Used only when no admin exists yet. Remove the password from this file after the first launch.
ADMIN_EMAIL=
ADMIN_NAME=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_PASSWORD=

# ---- Email (sign-in codes, payment links, receipts) ----------------------------------------------
# Real SMTP is required in production (deploy_check refuses a site that cannot email sign-in codes).
# Gmail: smtp.gmail.com, 587, your address, and an App Password (Google Account > Security >
# 2-Step Verification > App passwords). Payments and texts stay simulated.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ---- Optional AI service for AIR (empty = AI off; the rule-based engine always works) -----------
AI_TEXT_PROVIDER=
AI_TEXT_API_KEY=
AI_TEXT_MODEL=

# ---- Business details (shown on the site and in the structured data of the built pages) ---------
# These are BUILD values for the web image (GitHub repository variables or --build-arg); listed
# here so everything is in one place. Empty = the honest "demo project" labels.
VITE_BUSINESS_NAME=
VITE_BUSINESS_PHONE=
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_STREET=
VITE_BUSINESS_CITY=
VITE_BUSINESS_REGION=
VITE_BUSINESS_POSTAL_CODE=
VITE_BUSINESS_COUNTRY=IN

# ---- Optional tuning ------------------------------------------------------------------------------
# HSTS in seconds (one year). Do not lower once the site is live.
SALON_HSTS_SECONDS=31536000
SALON_LOG_LEVEL=INFO
