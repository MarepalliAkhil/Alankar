# Copy to backend/.env and fill in. Never commit backend/.env.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(50))"
SALON_SECRET_KEY=replace-with-a-long-random-string
SALON_DEBUG=true
SALON_ALLOWED_HOSTS=localhost,127.0.0.1

# Must match the values in the root .env used by docker-compose
SALON_DB_NAME=salon
SALON_DB_USER=salon
SALON_DB_PASSWORD=replace-with-the-same-password-as-root-env
SALON_DB_HOST=127.0.0.1
SALON_DB_PORT=55432

# Vite dev server origins allowed to call the API with cookies
SALON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Serve /api/schema/ and /api/docs/ (defaults to SALON_DEBUG)
SALON_API_DOCS=true

# Field-level encryption master key (phone numbers now; allergies, notes, chat later).
# 32 random bytes, base64. Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep it ONLY here. If you change it, data encrypted with the old key can no longer be read.
SALON_FIELD_KEY=replace-with-a-generated-key

# Where links in (simulated) emails point to
SALON_FRONTEND_URL=http://localhost:5173

# Rate limit for auth endpoints (login, register, password reset, invite accept)
SALON_AUTH_RATE=20/min
# Receptionists are signed out after this many idle minutes (default 15).
SALON_IDLE_MINUTES=15

# Real email (optional). Leave EMAIL_HOST empty to keep emails simulated (dev mailbox).
# Gmail: use a 16-character App password, never your account password. See README.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Task 8 hardening (all optional; safe defaults) ---
# Other rate limits (requests per client). Auth is SALON_AUTH_RATE above.
SALON_ANON_RATE=240/min
SALON_USER_RATE=600/min
SALON_BOOKING_RATE=20/min
SALON_PUBLIC_WRITE_RATE=20/min
# Behind a reverse proxy: how many proxies sit in front (0 = none). A wrong number lets
# callers forge their IP and dodge rate limits, so leave 0 unless you have a proxy.
SALON_NUM_PROXIES=0
# Set true only when a proxy terminates HTTPS and sends X-Forwarded-Proto.
SALON_BEHIND_PROXY=false
# HTTPS-only (production). 0 disables HSTS; default one year when DEBUG is off.
SALON_HSTS_SECONDS=31536000
SALON_HSTS_PRELOAD=false
