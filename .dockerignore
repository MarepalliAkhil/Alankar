# Keep secrets, local environments and large generated folders out of the image build context.
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example
!**/.env.production.local.example
.git
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
frontend/dist
frontend/dist-stats.html
frontend/e2e-results
frontend/e2e-report
frontend/test-results
frontend/playwright-report
frontend/mobile-screens
frontend/photos-originals
backend/staticfiles
backend/backups
